# Required: At least one API key
OPENAI_API_KEY=sk-your-key-here
# OR for Google Gemini:
# GEMINI_API_KEY=your-gemini-key-here
# OR for Ollama (local):
# BASE_URL=http://localhost:11434/v1

# PostgreSQL connection (optional; defaults to local documind database)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/documind

# JWT secret for authentication (required for auth to work)
JWT_SECRET=your-secure-random-secret-here

# Base URL for the API reference page (optional, defaults to http://localhost:3022)
# BASE_URL=https://your-domain.com
